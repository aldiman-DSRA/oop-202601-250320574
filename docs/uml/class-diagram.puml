@startuml class-diagram
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam monochrome false
skinparam linetype ortho

package "id.ac.upb.asetpinjam.kontrak" {
    interface DapatDipinjam {
        + bisaDipinjam() : boolean
    }

    interface AturanDenda {
        + hitung(aset : Aset, hariTerlambat : int) : long
    }
}

package "id.ac.upb.asetpinjam.model" {
    enum JenisAset {
        RUANG
        LAPTOP
        ALAT_LAB
    }

    enum Kondisi {
        BAIK
        RUSAK_RINGAN
        RUSAK_BERAT
    }

    enum StatusAset {
        TERSEDIA
        DIPINJAM
        RUSAK
    }

    enum StatusPeminjaman {
        DIAJUKAN
        DISETUJUI
        DITOLAK
        DIPINJAM
        DIBATALKAN
        DIKEMBALIKAN
        TERLAMBAT
    }

    enum TingkatRisiko {
        RENDAH
        SEDANG
        TINGGI
    }

    class Peminjam <<record>> {
        - id : String
        - nama : String
        + Peminjam(id : String, nama : String)
        + id() : String
        + nama() : String
    }

    abstract class Aset {
        - kode : String
        - nama : String
        - status : StatusAset
        - kondisi : Kondisi
        + Aset(kode : String, nama : String)
        + getKode() : String
        + getNama() : String
        + getStatus() : StatusAset
        + getKondisi() : Kondisi
        + setNama(nama : String) : void
        + setStatus(status : StatusAset) : void
        + setKondisi(kondisi : Kondisi) : void
        + bisaDipinjam() : boolean
        + {abstract} getJenis() : JenisAset
        + {abstract} hitungDenda(hariTerlambat : int) : long
    }

    class Ruang {
        - kapasitas : int
        + Ruang(kode : String, nama : String, kapasitas : int)
        + getKapasitas() : int
        + getJenis() : JenisAset
        + hitungDenda(hariTerlambat : int) : long
    }

    class Laptop {
        - spesifikasi : String
        - nomorInventaris : String
        + Laptop(kode : String, nama : String, spesifikasi : String, nomorInventaris : String)
        + getSpesifikasi() : String
        + getNomorInventaris() : String
        + getJenis() : JenisAset
        + hitungDenda(hariTerlambat : int) : long
    }

    class AlatLab {
        - laboratorium : String
        - tingkatRisiko : TingkatRisiko
        + AlatLab(kode : String, nama : String, laboratorium : String, tingkatRisiko : TingkatRisiko)
        + getLaboratorium() : String
        + getTingkatRisiko() : TingkatRisiko
        + getJenis() : JenisAset
        + hitungDenda(hariTerlambat : int) : long
    }

    class Peminjaman {
        - id : String
        - peminjam : Peminjam
        - aset : Aset
        - mulai : LocalDateTime
        - selesai : LocalDateTime
        - status : StatusPeminjaman
        + Peminjaman(id : String, peminjam : Peminjam, aset : Aset, mulai : LocalDateTime, selesai : LocalDateTime)
        + getId() : String
        + getPeminjam() : Peminjam
        + getAset() : Aset
        + getMulai() : LocalDateTime
        + getSelesai() : LocalDateTime
        + getStatus() : StatusPeminjaman
        + setStatusDariPenyimpanan(status : StatusPeminjaman) : void
        + ubahStatus(baru : StatusPeminjaman) : void
    }
}

package "id.ac.upb.asetpinjam.katalog" {
    class KatalogAset {
        - daftar : List<Aset>
        + tambah(aset : Aset) : void
        + semua() : List<Aset>
        + cari(kata : String) : List<Aset>
        + cari(kata : String, jenis : JenisAset) : List<Aset>
    }
}

package "id.ac.upb.asetpinjam.jadwal" {
    class JadwalPeminjaman {
        - daftar : List<Peminjaman>
        - kuotaLaptop : int
        + JadwalPeminjaman(kuotaLaptop : int)
        # kuotaLaptop() : int
        # daftarMutable() : List<Peminjaman>
        + tambah(p : Peminjaman) : void
        + bentrok(baru : Peminjaman) : boolean
        + semuaUrutMulai() : List<Peminjaman>
        + perAset() : Map<String, List<Peminjaman>>
        + hapus(id : String) : boolean
        + ajukan(baru : Peminjaman) : void
    }
}

package "id.ac.upb.asetpinjam.denda" {
    class DendaFlat {
        + hitung(aset : Aset, hariTerlambat : int) : long
    }

    class DendaProgresif {
        + hitung(aset : Aset, hariTerlambat : int) : long
    }

    class LayananDenda {
        - aturan : AturanDenda
        + LayananDenda(aturan : AturanDenda)
        + hitung(aset : Aset, hariTerlambat : int) : long
    }
}

package "id.ac.upb.asetpinjam.config" {
    class Varian {
        + dendaPerHari : long
        + batasDurasiRuang : int
        + kuotaLaptop : int
        + {static} aktif() : Varian
    }
}

package "id.ac.upb.asetpinjam.exception" {
    class AsetPinjamException
    class PeminjamanBentrokException
    class KuotaHabisException
    class StatusTidakSahException
    class DataAksesException
}

package "id.ac.upb.asetpinjam.dao" {
    interface AsetDAO {
        + simpan(aset : Aset) : void
        + cariByKode(kode : String) : Optional<Aset>
        + semua() : List<Aset>
        + perbarui(aset : Aset) : void
        + hapus(kode : String) : boolean
    }

    interface PeminjamanDAO {
        + simpan(peminjaman : Peminjaman) : void
        + cariById(id : String) : Optional<Peminjaman>
        + perbaruiStatus(id : String, status : StatusPeminjaman) : boolean
    }
}

' Relasi Pewarisan & Realisasi
Aset ..|> DapatDipinjam : implements
Ruang --|> Aset : extends
Laptop --|> Aset : extends
AlatLab --|> Aset : extends

DendaFlat ..|> AturanDenda : implements
DendaProgresif ..|> AturanDenda : implements

PeminjamanBentrokException --|> AsetPinjamException : extends
KuotaHabisException --|> AsetPinjamException : extends
StatusTidakSahException --|> AsetPinjamException : extends
DataAksesException --|> AsetPinjamException : extends

' Relasi Asosiasi & Agregasi dengan Multiplicity
Aset "1" --> "1" StatusAset : status
Aset "1" --> "1" Kondisi : kondisi
AlatLab "1" --> "1" TingkatRisiko : tingkatRisiko

Peminjaman "*" --> "1" Peminjam : peminjam
Peminjaman "*" --> "1" Aset : aset
Peminjaman "*" --> "1" StatusPeminjaman : status

KatalogAset "1" o-- "*" Aset : daftar
JadwalPeminjaman "1" o-- "*" Peminjaman : daftar
LayananDenda "1" o-- "1" AturanDenda : aturan

' Ketergantungan (Dependency)
AturanDenda ..> Aset : uses
Aset ..> Varian : dendaPerHari

@enduml